---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ ocloud_manager_namespace }}
---
apiVersion: operators.coreos.com/v1
kind: OperatorGroup
metadata:
  name: ocloud-manager-operator-group
  namespace: {{ ocloud_manager_namespace }}
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: ocloud-manager-operator
  namespace: {{ ocloud_manager_namespace }}
spec:
  installPlanApproval: Automatic
  name: o-cloud-manager
  channel: {{ ocloud_manager_channel }}
  source: "{{ ocloud_manager_source }}"
  sourceNamespace: openshift-marketplace
