---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

generators:
{% for prof in ocloud_clustertemplate_profiles %}
- {{ prof.name }}/{{ prof.name }}-pg-{{ ocloud_clustertemplate_version }}.yaml
{% endfor %}

resources:
{% for prof in ocloud_clustertemplate_profiles %}
- {{ prof.name }}/ns.yaml
- {{ prof.name }}/msc-binding.yaml
{% endfor %}
