    # SRIOV NETWORKS
    - path: source-crs/sriov-operator/SriovNetwork.yaml
      patches:
      - metadata:
          name: sriov-nw-du-fh
        spec:
          resourceName: du_fh
          vlan: '{% raw %}{{hub fromConfigMap "" (printf "%s-pg" .ManagedClusterName) "sriov-network-vlan-1" | toInt hub}}{% endraw %}'
    - path: source-crs/sriov-operator/SriovNetworkNodePolicy-SetSelector.yaml
      patches:
      - metadata:
          name: sriov-nnp-du-fh
        spec:
          deviceType: netdevice
          isRdma: false
          nicSelector:
            pfNames: '{% raw %}{{hub fromConfigMap "" (printf "%s-pg" .ManagedClusterName) "sriov-network-pfNames-1" | toLiteral hub}}{% endraw %}'
          nodeSelector:
            node-role.kubernetes.io/worker: ""
          numVfs: 8
          priority: 10
          resourceName: du_fh
    - path: source-crs/sriov-operator/SriovNetwork.yaml
      patches:
      - metadata:
          name: sriov-nw-du-mh
        spec:
          resourceName: du_mh
          vlan: '{% raw %}{{hub fromConfigMap "" (printf "%s-pg" .ManagedClusterName) "sriov-network-vlan-2" | toInt hub}}{% endraw %}'
    - path: source-crs/sriov-operator/SriovNetworkNodePolicy-SetSelector.yaml
      patches:
      - metadata:
          name: sriov-nnp-du-mh
        spec:
          deviceType: vfio-pci
          isRdma: false
          nicSelector:
            pfNames: '{% raw %}{{hub fromConfigMap "" (printf "%s-pg" .ManagedClusterName) "sriov-network-pfNames-2" | toLiteral hub}}{% endraw %}'
          nodeSelector:
            node-role.kubernetes.io/worker: ""
          numVfs: 8
          priority: 10
          resourceName: du_mh

{% if ocloud_performance_profile_enabled %}
# DU VALIDATOR
- name: v1-du-validator-policy
  remediationAction: inform
  evaluationInterval:
    compliant: never
    noncompliant: 10s
  manifests:
    - path: source-crs/validatorCRs/informDuValidatorWorker.yaml
