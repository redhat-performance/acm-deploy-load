---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

configMapGenerator:
{% for prof in ocloud_clustertemplate_profiles %}
{% if 'ai' in prof.install_types %}
- files:
  - extra-manifest/marketplace-ns.yaml
  - extra-manifest/98-var-lib-containers-partitioned.yaml
{% if include_crun_extra_manifests %}
  - extra-manifest/enable-crun-master.yaml
  - extra-manifest/enable-crun-worker.yaml
{% endif %}
  name: {{ prof.name }}-extra-manifest-v1
  namespace: version-{{ ocloud_clustertemplate_ocp_version | replace('.', '-') }}-{{ prof.name }}
{% endif %}
- files:
  - ibu-manifest/PlatformBackupRestore.yaml
  name: {{ prof.name }}-ibu-platform-backup-{{ ocloud_clustertemplate_version }}-1
  namespace: openshift-adp
{% endfor %}
generatorOptions:
  disableNameSuffixHash: true

resources:
{% for prof in ocloud_clustertemplate_profiles %}
- ./{{ prof.name }}/ns.yaml
- ./{{ prof.name }}/pull-secret.yaml
{% for it in prof.install_types %}
- ./{{ prof.name }}/clusterinstance-defaults-{{ it }}-v1.yaml
{% endfor %}
{% for it in prof.install_types %}
- ./{{ prof.name }}/{{ prof.name }}-{{ ocloud_clustertemplate_version }}-{{ it }}-v1.yaml
- ./{{ prof.name }}/{{ prof.name }}-{{ ocloud_clustertemplate_version }}-{{ it }}-v2.yaml
- ./{{ prof.name }}/{{ prof.name }}-{{ ocloud_clustertemplate_version }}-{{ it }}-v3.yaml
{% endfor %}
- ./{{ prof.name }}/policytemplates-defaults-v1.yaml
{% endfor %}
