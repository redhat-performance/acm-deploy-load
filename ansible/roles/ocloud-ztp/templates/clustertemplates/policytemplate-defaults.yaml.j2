---
apiVersion: v1
kind: ConfigMap
metadata:
  name: policytemplate-defaults-v1
  namespace: {{ ocloud_clustertemplate_namespace }}
data:
  policytemplate-defaults: |
    cluster-log-fwd-filters-labels: '{"label1": "test1", "label2": "test2"}'
    cluster-log-fwd-outputs-url: "tcp://198.51.100.50:9092/test"
    cpu-isolated: "2-31"
    cpu-reserved: "0-1"
    hugepages-count: "16"
    hugepages-default: "1G"
    hugepages-size: "1G"
    install-plan-approval: "Automatic"
    oadp-s3url: "{{ oadp_s3Url }}"
    ptpcfgslave-profile-interface: ens15f1
    sriov-network-vlan-1: "140"
    sriov-network-pfNames-1: '["ens2f0"]'
    storage-lv-devicePaths-1: /dev/disk/by-path/pci-0000:62:00.0-scsi-0:2:8:0
