---
apiVersion: policy.open-cluster-management.io/v1
kind: PolicyGenerator
metadata:
  name: {{ ocloud_clustertemplate_name }}-pg-{{ ocloud_clustertemplate_version }}
policyDefaults:
  namespace: {{ ocloud_policy_namespace }}
  # Use an existing placement rule so that placement bindings can be consolidated
  placement:
    # These labels must match the labels set for the ManagedCluster either through the ProvisioningRequest
    # or the ClusterInstance ConfigMap.
    labelSelector:
      cluster-version: {{ ocloud_clustertemplate_version}}
      sno-ran-du-policy: "v1"
  policyAnnotations:
    # This annotation contains a comma-separated list of ClusterTemplates (metadata.name) this PG is associated with.
    # This is used for linking the generated root policies to the ClusterTemplate used by the ProvisioningRequest.
    clustertemplates.clcm.openshift.io/templates: "{{ ocloud_clustertemplate_name }}.{{ ocloud_clustertemplate_version }}"
  remediationAction: enforce
  severity: low
  namespaceSelector:
    exclude:
      - kube-*
    include:
      - '*'
  evaluationInterval:
    compliant: 10m
    noncompliant: 10s
  orderPolicies: true
policies:
{% if rhacm_disconnected_registry and rhacm_disconnected_registry|length > 1 %}
# CATALOG SOURCE - DISCONNECTED REGISTRY
- name: v1-catalog-source-policy
  manifests:
  - path: source-crs/disconnected-registry/DefaultCatsrc.yaml
    patches:
    - metadata:
        name: redhat-operators-disconnected
      spec:
        displayName: disconnected-redhat-operators
        image: {{ rhacm_disconnected_registry }}:{{ rhacm_disconnected_registry_port }}/{{ disconnected_operator_index_name }}:{{ operator_index_tag }}
  - path: source-crs/disconnected-registry/DefaultCatsrc.yaml
    patches:
    - metadata:
        name: certified-operators-disconnected
      spec:
        displayName: disconnected-certified-operators
        image: {{ rhacm_disconnected_registry }}:{{ rhacm_disconnected_registry_port }}/{{ disconnected_certified_operator_index_name }}:{{ disconnected_certified_operator_index_tag }}
  - path: source-crs/disconnected-registry/DisconnectedIDMS.yaml
    patches:
    - spec:
        imageDigestMirrors:
        - mirrors:
          - {{ rhacm_disconnected_registry }}:{{ rhacm_disconnected_registry_port }}/openshift/release-images
          source: quay.io/openshift-release-dev/ocp-release
        - mirrors:
          - {{ rhacm_disconnected_registry }}:{{ rhacm_disconnected_registry_port }}/openshift/release
          source: quay.io/openshift-release-dev/ocp-v4.0-art-dev
        - mirrors:
          - {{ rhacm_disconnected_registry }}:{{ rhacm_disconnected_registry_port }}/openshift/release
          source: quay.io/openshift-release-dev/ocp-v5.0-art-dev
        - mirrors:
          - {{ rhacm_disconnected_registry }}:{{ rhacm_disconnected_registry_port }}
          source: registry.redhat.io
        - mirrors:
          - {{ rhacm_disconnected_registry }}:{{ rhacm_disconnected_registry_port }}
          source: registry.connect.redhat.com
        - mirrors:
          - {{ rhacm_disconnected_registry }}:{{ rhacm_disconnected_registry_port }}/rhacm2
          - {{ rhacm_disconnected_registry }}:{{ rhacm_disconnected_registry_port }}/acm-d
          source: registry.redhat.io/rhacm2
        - mirrors:
          - {{ rhacm_disconnected_registry }}:{{ rhacm_disconnected_registry_port }}/multicluster-engine
          - {{ rhacm_disconnected_registry }}:{{ rhacm_disconnected_registry_port }}/acm-d
          source: registry.redhat.io/multicluster-engine
        - mirrors:
          - {{ rhacm_disconnected_registry }}:{{ rhacm_disconnected_registry_port }}/acm-d
          - {{ rhacm_disconnected_registry }}:{{ rhacm_disconnected_registry_port }}/rhacm2
          source: quay.io/acm-d
{% endif %}

# SUBSCRIPTIONS
- name: v1-subscriptions-policy
  manifests:
  # Cluster Logging operator
  - path: source-crs/cluster-logging/ClusterLogNS.yaml
  - path: source-crs/cluster-logging/ClusterLogOperGroup.yaml
  - path: source-crs/cluster-logging/ClusterLogSubscription.yaml
    patches:
    - spec:
        source: {{ 'redhat-operators-disconnected' if rhacm_disconnected_registry and rhacm_disconnected_registry|length > 1 else 'redhat-operators' }}
        installPlanApproval:
          {%- raw %}
          '{{hub $configMap:=(lookup "v1" "ConfigMap" "" (printf "%s-pg" .ManagedClusterName)) hub}}{{hub dig "data" "install-plan-approval" "Manual" $configMap hub}}'
          {%- endraw +%}
  - path: source-crs/cluster-logging/ClusterLogOperatorStatus.yaml
  - path: source-crs/cluster-logging/ClusterLogServiceAccount.yaml
  - path: source-crs/cluster-logging/ClusterLogServiceAccountAuditBinding.yaml
  - path: source-crs/cluster-logging/ClusterLogServiceAccountInfrastructureBinding.yaml
  # PTP operator
  - path: source-crs/ptp-operator/PtpSubscriptionNS.yaml
  - path: source-crs/ptp-operator/PtpSubscription.yaml
    patches:
    - spec:
        source: {{ 'redhat-operators-disconnected' if rhacm_disconnected_registry and rhacm_disconnected_registry|length > 1 else 'redhat-operators' }}
        installPlanApproval:
          {%- raw %}
          '{{hub $configMap:=(lookup "v1" "ConfigMap" "" (printf "%s-pg" .ManagedClusterName)) hub}}{{hub or (index $configMap.data "install-plan-approval") "Manual" hub}}'
          {%- endraw +%}
  - path: source-crs/ptp-operator/PtpSubscriptionOperGroup.yaml
  - path: source-crs/ptp-operator/PtpOperatorStatus.yaml
  # SRIOV operator
  - path: source-crs/sriov-operator/SriovSubscriptionNS.yaml
  - path: source-crs/sriov-operator/SriovSubscriptionOperGroup.yaml
  - path: source-crs/sriov-operator/SriovSubscription.yaml
    patches:
    - spec:
        source: {{ 'redhat-operators-disconnected' if rhacm_disconnected_registry and rhacm_disconnected_registry|length > 1 else 'redhat-operators' }}
        installPlanApproval:
          {%- raw %}
          '{{hub $configMap:=(lookup "v1" "ConfigMap" "" (printf "%s-pg" .ManagedClusterName)) hub}}{{hub dig "data" "install-plan-approval" "Manual" $configMap hub}}'
          {%- endraw +%}
  - path: source-crs/sriov-operator/SriovOperatorStatus.yaml
  # SRIOV Accelerator
  - path: source-crs/sriov-fec-operator/AcceleratorsNS.yaml
  - path: source-crs/sriov-fec-operator/AcceleratorsOperGroup.yaml
  - path: source-crs/sriov-fec-operator/AcceleratorsSubscription.yaml
    patches:
    - spec:
        channel: "stable"
        source: {{ 'certified-operators-disconnected' if rhacm_disconnected_registry and rhacm_disconnected_registry|length > 1 else 'certified-operators' }}
        installPlanApproval:
        {%- raw %}
          '{{hub $configMap:=(lookup "v1" "ConfigMap" "" (printf "%s-pg" .ManagedClusterName)) hub}}{{hub dig "data" "install-plan-approval" "Manual" $configMap hub}}'
        {%- endraw +%}
  - path: source-crs/sriov-fec-operator/AcceleratorsOperatorStatus.yaml
  # LCA
  - path: source-crs/lca/LcaSubscriptionNS.yaml
  - path: source-crs/lca/LcaSubscriptionOperGroup.yaml
  - path: source-crs/lca/LcaSubscription.yaml
    patches:
    - spec:
        source: {{ 'redhat-operators-disconnected' if rhacm_disconnected_registry and rhacm_disconnected_registry|length > 1 else 'redhat-operators' }}
        installPlanApproval:
          {%- raw %}
          '{{hub $configMap:=(lookup "v1" "ConfigMap" "" (printf "%s-pg" .ManagedClusterName)) hub}}{{hub dig "data" "install-plan-approval" "Manual" $configMap hub}}'
          {%- endraw +%}
  - path: source-crs/lca/LcaOperatorStatus.yaml
  # OADP
  - path: source-crs/data-protection/OadpSubscriptionNS.yaml
  - path: source-crs/data-protection/OadpSubscriptionOperGroup.yaml
  - path: source-crs/data-protection/OadpSubscription.yaml
    patches:
    - spec:
        source: {{ 'redhat-operators-disconnected' if rhacm_disconnected_registry and rhacm_disconnected_registry|length > 1 else 'redhat-operators' }}
        installPlanApproval:
          {%- raw %}
          '{{hub $configMap:=(lookup "v1" "ConfigMap" "" (printf "%s-pg" .ManagedClusterName)) hub}}{{hub dig "data" "install-plan-approval" "Manual" $configMap hub}}'
          {%- endraw +%}
  - path: source-crs/data-protection/OadpOperatorStatus.yaml
  # Local storage operator
  - path: source-crs/storage-lso/StorageNS.yaml
  - path: source-crs/storage-lso/StorageOperGroup.yaml
  - path: source-crs/storage-lso/StorageSubscription.yaml
    patches:
    - spec:
        source: {{ 'redhat-operators-disconnected' if rhacm_disconnected_registry and rhacm_disconnected_registry|length > 1 else 'redhat-operators' }}
        installPlanApproval:
          {%- raw %}
          '{{hub $configMap:=(lookup "v1" "ConfigMap" "" (printf "%s-pg" .ManagedClusterName)) hub}}{{hub dig "data" "install-plan-approval" "Manual" $configMap hub}}'
          {%- endraw +%}
  - path: source-crs/storage-lso/StorageOperatorStatus.yaml
# CONFIGURATION POLICY
- name: v1-config-policy
  manifests:
    - path: source-crs/cluster-tuning/DisableOLMPprof.yaml
    - path: source-crs/cluster-tuning/disabling-network-diagnostics/DisableSnoNetworkDiag.yaml
