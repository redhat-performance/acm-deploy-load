# OADP (Optional)
- name: v1-oadp-config-policy
  policyAnnotations:
    ran.openshift.io/ztp-deploy-wave: "100"
  manifests:
    - path: source-crs/data-protection/OadpSecret.yaml
      patches:
      - data:
          cloud: {{ lookup('template', './s3-creds.j2') | b64encode }}
    - path: source-crs/data-protection/OadpDataProtectionApplication.yaml
      patches:
      - spec:
          backupLocations:
          - velero:
              provider: aws
              default: true
              credential:
                key: cloud
                name: cloud-credentials
              config:
                profile: "default"
                region: us-east-1
                s3Url: '{% raw %}{{hub fromConfigMap "" (printf "%s-pg" .ManagedClusterName) "oadp-s3url" hub}}{% endraw %}'
                insecureSkipTLSVerify: "true"
                s3ForcePathStyle: "true"
              objectStorage:
                bucket: ibu
                prefix: '{% raw %}{{hub .ManagedClusterName hub}}-ibu{% endraw %}'
    - path: source-crs/data-protection/OadpBackupStorageLocationStatus.yaml
