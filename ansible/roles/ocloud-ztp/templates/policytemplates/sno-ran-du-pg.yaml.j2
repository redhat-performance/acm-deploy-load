    # PTP CONFIG
    - path: source-crs/ptp-operator/PtpOperatorConfig.yaml
      patches:
      - spec:
          daemonNodeSelector:
            $patch: replace
            node-role.kubernetes.io/master: ""
    - path: source-crs/ptp-operator/configuration/PtpConfigSlave.yaml
      openapi:
        path: {{ ocloud_clustertemplate_name }}/schema.openapi
      patches:
        - metadata:
            name: du-ptp-slave
          spec:
            profile:
            - interface: '{% raw %}{{hub fromConfigMap "" (printf "%s-pg" .ManagedClusterName) "ptpcfgslave-profile-interface" hub}}{% endraw %}'
              name: slave
            recommend:
            - match:
              - nodeLabel: node-role.kubernetes.io/master
              priority: 4
              profile: slave
    # SRIOV OPERATOR CONFIG
    - path: source-crs/sriov-operator/SriovOperatorConfig.yaml
      complianceType: musthave
      patches:
      - spec:
          configDaemonNodeSelector:
            $patch: replace
            node-role.kubernetes.io/master: ""
          disableDrain: true
    # LOCAL STORAGE CONFIG
    - path: source-crs/storage/StorageLV.yaml
      patches:
      - spec:
          storageClassDevices:
          - storageClassName: "example-storage-class-1"
            volumeMode: Filesystem
            fsType: xfs
            devicePaths: '{% raw %}{{hub fromConfigMap "" (printf "%s-pg" .ManagedClusterName) "storage-lv-devicePaths-1" | toLiteral hub}}{% endraw %}'
    - path: source-crs/storage-lso/StorageClass.yaml
      patches:
      - metadata:
          name: example-storage-class-1
#     # CLUSTER LOGGING
    - path: source-crs/cluster-logging/ClusterLogForwarder.yaml
      openapi:
        path: {{ ocloud_clustertemplate_name }}/schema.openapi
      patches:
      - spec:
          filters:
          - name: ran-du-labels
            openshiftLabels: '{% raw %}{{hub fromConfigMap "" (printf "%s-pg" .ManagedClusterName) "cluster-log-fwd-filters-labels" | toLiteral hub}}{% endraw %}'
          outputs:
          - kafka:
              # below url is an example
              url: '{% raw %}{{hub fromConfigMap "" (printf "%s-pg" .ManagedClusterName) "cluster-log-fwd-outputs-url"  | toLiteral hub}}{% endraw %}'
            # The name is needed for a correct merge with the source-cr.
            name: kafka-output
